# ==============================================================================
# OncoGemma v5 - FastAPI Control Plane Container (Cloud Run)
# ==============================================================================
FROM python:3.12-slim AS base

# Prevent Python from writing .pyc files and enable unbuffered streaming logs
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Install system dependencies for OpenSlide and PyVips
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libvips-dev \
    libvips42 \
    libopenslide-dev \
    libopenslide0 \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy backend application source
COPY backend /app/backend
COPY configs /app/configs

WORKDIR /app/backend

# Default Cloud Run port is 8080
ENV PORT=8080
EXPOSE 8080

CMD exec python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --workers 1
