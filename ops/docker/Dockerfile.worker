# ==============================================================================
# OncoGemma v5 - Asynchronous High-Power Pipeline Worker (Cloud Run Jobs / Batch)
# Multi-threaded SIMD image processing, Macenko stain engine, and ONNX Runtime
# ==============================================================================
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    VIPS_WARNING=0

WORKDIR /app

# Install native OpenSlide, PyVips, and OpenCV libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libvips-tools \
    libvips-dev \
    libvips42 \
    libopenslide-dev \
    libopenslide0 \
    libgl1 \
    libglib2.0-0 \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements
COPY backend/requirements.txt /app/requirements.txt
COPY backend/requirements-worker.txt /app/requirements-worker.txt

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-worker.txt

# Copy source and configurations
COPY backend /app/backend
COPY configs /app/configs
COPY models /app/models

WORKDIR /app/backend

# Default entrypoint for Cloud Run Jobs or Cloud Tasks webhooks
ENTRYPOINT ["python", "worker/cloud_job_entry.py"]
